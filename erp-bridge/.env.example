# ---- Porta do servico ----
PORT=4000

# ---- ERP (API web da Inntegra) ----
ERP_BASE_URL=https://somos-backend.inntegra.com.br
# Empresas (bancos) a consultar, separadas por virgula
ERP_EMPRESAS=somosemp,somosfilial,somosbahia,somosto,somosgo,somosnordestenovo
# Header de device que a API espera (pegue um valido do app, via DevTools)
ERP_DEVICE_ID=
# Janela de datas do espelho
OS_LOOKBACK_DAYS=180
OS_FORWARD_DAYS=365
OS_TIPO_DATA=DataEntrada

# ---- Bom-cidadao: evita martelar o ERP ----
# TTL do cache em segundos: N aberturas de painel = no maximo 1 chamada por TTL
CACHE_TTL_SECONDS=120
ERP_TIMEOUT_MS=15000
# User-Agent identificavel. NAO mascaramos trafego: nos identificamos.
ERP_USER_AGENT=somos-chatwoot-bridge/0.1

# ---- Modo mock: usa dados de exemplo locais, sem chamar o ERP (roda ja) ----
MOCK=true

# ---- Protecao do proprio bridge (opcional) ----
BRIDGE_TOKEN=

# ---- Escrita de campos de OS (OFF por padrao) ----
# So habilite apontando no ERP real DEPOIS de testar numa OS segura/homologacao.
# Endpoints confirmados por captura: UpdateSubStatusOS, GravaHistoricoSubStatusOS, UpdateDefeitos.
WRITE_ENABLED=false
ERP_ID_USUARIO=0
